# Entorno de ejecución: development | production
# En production se ocultan los detalles internos de los errores 500 en las respuestas.
NODE_ENV=development

# Puerto donde correrá la API
PORT=

# Host de la base de datos PostgreSQL
DB_HOST=

# Puerto de la base de datos PostgreSQL
DB_PORT=

# Nombre de la base de datos
DB_NAME=

# Usuario de PostgreSQL
DB_USER=

# Contraseña del usuario de PostgreSQL
DB_PASSWORD=

# Clave secreta para firmar los tokens JWT
JWT_SECRET=

# Tiempo de expiración del token JWT
JWT_EXPIRES_IN=1d

# Topes de rate limiting (opcionales; si se dejan vacíos se usan los valores
# por defecto pensados para producción: 300 / 10 / 3 respectivamente).
# AUTH_RATE_LIMIT_MAX: intentos de login/registro/cambio de contraseña por IP cada 15 min.
# API_RATE_LIMIT_MAX: solicitudes totales a /api por IP cada 15 min.
# CREATE_RATE_LIMIT_MAX: creaciones (pedidos/pagos/domicilios) por usuario cada 10 seg.
AUTH_RATE_LIMIT_MAX=
API_RATE_LIMIT_MAX=
CREATE_RATE_LIMIT_MAX=

# Credenciales de Cloudinary (para subir imágenes de productos, marcas, banners, etc.)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# URL del frontend, usada para armar el enlace de recuperación de contraseña
FRONTEND_URL=

# Orígenes adicionales permitidos por CORS, separados por coma (por ejemplo,
# el dominio del frontend en producción). FRONTEND_URL siempre se incluye
# automáticamente, igual que http://localhost:5173 para desarrollo.
CORS_ORIGINS=

# Configuración SMTP para el envío de correos (recuperación de contraseña, etc.)
# Si se dejan vacías, el correo no se envía y solo se registra en consola (útil en desarrollo)

# Servidor SMTP de tu proveedor de correo. Lo da el proveedor, por ejemplo:
#   Gmail: smtp.gmail.com | Outlook/Office365: smtp.office365.com
#   Servicios transaccionales (recomendados para producción): Brevo (Sendinblue),
#   Mailgun, Resend, Amazon SES, etc. — el host aparece en su panel de "SMTP settings".
SMTP_HOST=

# Puerto del servidor SMTP: 587 para TLS (lo normal) o 465 para SSL.
SMTP_PORT=587

# true si usas el puerto 465 (SSL), false si usas 587 (TLS).
SMTP_SECURE=false

# Usuario SMTP. En Gmail/Outlook es tu correo completo; en servicios
# transaccionales suele ser un usuario o API key que te asigna su panel.
SMTP_USER=

# Contraseña SMTP. NO uses tu contraseña normal de la cuenta:
#   Gmail: genera una "contraseña de aplicación" en
#     https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos activada).
#   Servicios transaccionales: usa la API key/SMTP key de su panel.
SMTP_PASS=

# Dirección que verá el destinatario como remitente. Debe ser un correo/dominio
# verificado en tu proveedor SMTP (en Gmail/Outlook, usa el mismo que SMTP_USER).
MAIL_FROM=