NODE_ENV=development
PORT=

DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# true si la base de datos exige SSL (Aiven y la mayoría de hostings
# administrados lo exigen); en Postgres local normalmente se deja vacío/false.
DB_SSL=

JWT_SECRET=
JWT_EXPIRES_IN=1d

# Solo usadas por `npm run seed:db` para crear el usuario ADMIN inicial.
# ADMIN_DOCUMENTO, ADMIN_EMAIL, ADMIN_PASSWORD, ADMIN_NOMBRE y ADMIN_APELLIDO
# son obligatorias; el resto son opcionales. ADMIN_PASSWORD debe tener al
# menos 8 caracteres (se hashea automáticamente con bcrypt).
ADMIN_DOCUMENTO=
ADMIN_TIPO_DOCUMENTO=CC
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE=
ADMIN_APELLIDO=
ADMIN_TELEFONO=
ADMIN_GENERO=
ADMIN_DIRECCION=
ADMIN_BARRIO=

# Topes de rate limiting: NO se declaran aquí a propósito. Son opcionales
# (AUTH_RATE_LIMIT_MAX, API_RATE_LIMIT_MAX, CREATE_RATE_LIMIT_MAX) y si no
# existen la app usa sus valores por defecto de producción (10 / 1500 / 3).
# No las agregues en Render/tu hosting salvo que de verdad quieras un número
# distinto — dejarlas como campos vacíos ahí invita a que el botón
# "Generate" (pensado para secrets) les ponga sin querer un valor aleatorio,
# que es justo el bug que causó los 429 masivos en este proyecto.

# Cloudinary (para subir imágenes: productos, marcas, banners, avatares).
# Crea una cuenta gratuita en https://cloudinary.com y copia estos tres
# valores desde su dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# URL del frontend, usada para armar el enlace de recuperación de contraseña
FRONTEND_URL=

# Orígenes adicionales permitidos por CORS, separados por coma (por ejemplo,
# el dominio del frontend en producción). FRONTEND_URL siempre se incluye
# automáticamente, igual que http://localhost:5173 para desarrollo.
CORS_ORIGINS=

# Envío de correos (recuperación de contraseña, etc.) vía la API HTTP de Brevo.
# Se usa la API en vez de SMTP porque muchos hostings gratuitos bloquean los
# puertos SMTP salientes. Si se dejan vacías, el correo no se envía y solo se
# registra en consola (útil en desarrollo).

# API key de Brevo: panel de Brevo → SMTP & API → pestaña API Keys.
BREVO_API_KEY=

# Dirección que verá el destinatario como remitente. Debe estar verificada en
# Brevo (panel → Senders, Domains & Dedicated IPs → Senders).
MAIL_FROM=
